// BankAuction.co — core database schema
// MongoDB Atlas via Prisma (migrated from Supabase PostgreSQL).
// Design notes:
// - Fixed columns cover the common, always-relevant fields per the spec.
// - PropertyAttribute is an EAV table for category-specific fields (Khasra, BHK, vehicle make, etc.)
//   so we never add a column for a field that only applies to one property type.
// - Every ingested fact keeps provenance back to a SourceRecord.
// - MongoDB migration notes:
//   - All @id fields use @map("_id") to map to MongoDB's _id field.
//   - Composite @@id join tables converted to @@unique with synthetic id field.
//   - GIN trigram indexes removed (use Atlas Search for full-text queries).
//   - @db.Decimal replaced with Float (MongoDB has no SQL Decimal type).
//   - @db.Text annotations removed (no-op in MongoDB).
//   - directUrl removed (MongoDB does not use a direct connection URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

// ---------------------------------------------------------------------------
// Geography
// ---------------------------------------------------------------------------

model State {
  id        String     @id @default(cuid()) @map("_id")
  name      String     @unique
  slug      String     @unique
  districts District[]
  cities    City[]
  createdAt DateTime   @default(now())

  @@map("states")
}

model District {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  slug      String
  stateId   String
  state     State    @relation(fields: [stateId], references: [id])
  cities    City[]
  createdAt DateTime @default(now())

  @@unique([stateId, slug])
  @@map("districts")
}

model City {
  id           String      @id @default(cuid()) @map("_id")
  name         String
  slug         String      @unique
  stateId      String
  state        State       @relation(fields: [stateId], references: [id])
  districtId   String?
  district     District?   @relation(fields: [districtId], references: [id])
  latitude     Float?
  longitude    Float?
  properties   Property[]
  bankBranches BankBranch[]
  createdAt    DateTime    @default(now())

  @@map("cities")
}

// ---------------------------------------------------------------------------
// Banks
// ---------------------------------------------------------------------------

model Bank {
  id          String       @id @default(cuid()) @map("_id")
  name        String       @unique
  slug        String       @unique
  shortCode   String?
  logoUrl     String?
  website     String?
  branches    BankBranch[]
  auctions    Auction[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("banks")
}

model BankBranch {
  id        String   @id @default(cuid()) @map("_id")
  bankId    String
  bank      Bank     @relation(fields: [bankId], references: [id])
  name      String
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id])
  address   String?
  phone     String?
  email     String?
  auctions  Auction[]
  createdAt DateTime @default(now())

  @@unique([bankId, name])
  @@map("bank_branches")
}

// ---------------------------------------------------------------------------
// Property classification
// ---------------------------------------------------------------------------

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  LAND_PLOT
  AGRICULTURAL
  VEHICLE
}

model PropertyType {
  id        String            @id @default(cuid()) @map("_id")
  category  PropertyCategory
  name      String
  slug      String            @unique
  subtypes  PropertySubtype[]
  properties Property[]
  createdAt DateTime          @default(now())

  @@map("property_types")
}

model PropertySubtype {
  id             String       @id @default(cuid()) @map("_id")
  propertyTypeId String
  propertyType   PropertyType @relation(fields: [propertyTypeId], references: [id])
  name           String
  slug           String
  properties     Property[]
  createdAt      DateTime     @default(now())

  @@unique([propertyTypeId, slug])
  @@map("property_subtypes")
}

model Amenity {
  id         String              @id @default(cuid()) @map("_id")
  name       String              @unique
  slug       String              @unique
  properties PropertyAmenity[]

  @@map("amenities")
}

// Composite @@id converted to synthetic id + @@unique for MongoDB compatibility.
model PropertyAmenity {
  id         String   @id @default(cuid()) @map("_id")
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id])

  @@unique([propertyId, amenityId])
  @@map("property_amenities")
}

model PropertyAttribute {
  id             String    @id @default(cuid()) @map("_id")
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  key            String
  value          String?
  unit           String?
  isKnown        Boolean   @default(true)
  sourceRecordId String?
  sourceRecord   SourceRecord? @relation(fields: [sourceRecordId], references: [id])
  createdAt      DateTime  @default(now())

  @@unique([propertyId, key])
  @@map("property_attributes")
}

// ---------------------------------------------------------------------------
// Property + Auction (the core entities)
// ---------------------------------------------------------------------------

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  DUPLICATE
  EXPIRED
  REMOVED
}

model Property {
  id               String            @id @default(cuid()) @map("_id")
  slug             String            @unique
  title            String
  description      String?
  category         PropertyCategory?
  propertyTypeId   String?
  propertyType     PropertyType?     @relation(fields: [propertyTypeId], references: [id])
  subtypeId        String?
  subtype          PropertySubtype?  @relation(fields: [subtypeId], references: [id])

  cityId           String?
  city             City?             @relation(fields: [cityId], references: [id])
  addressText      String?
  latitude         Float?
  longitude        Float?

  status           PropertyStatus    @default(PENDING_REVIEW)
  extractionConfidence Float?

  geoCity          String?
  geoLocality      String?
  geoState         String?
  geoCheckedAt     DateTime?

  attributes       PropertyAttribute[]
  amenities        PropertyAmenity[]
  auctions         Auction[]
  documents        PropertyDocument[]
  media            PropertyMedia[]
  changes          PropertyChange[]
  sourceRecords    SourceRecord[]
  savedBy          SavedProperty[]
  leads            Lead[]
  supportTickets   SupportTicket[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([category, status])
  @@index([cityId])
  @@index([geoCity])
  // Full-text search: add Atlas Search index on title, description, addressText, geoCity, geoLocality
  // via MongoDB Atlas UI (replaces the removed PostgreSQL GIN trigram indexes).
  @@map("properties")
}

enum AuctionStatus {
  UPCOMING
  LIVE
  AUCTION_TODAY
  COMPLETED
  POSTPONED
  CANCELLED
  EXPIRED
}

model Auction {
  id                    String        @id @default(cuid()) @map("_id")
  propertyId            String
  property              Property      @relation(fields: [propertyId], references: [id])

  bankId                String?
  bank                  Bank?         @relation(fields: [bankId], references: [id])
  branchId              String?
  branch                BankBranch?   @relation(fields: [branchId], references: [id])

  externalAuctionId     String?
  noticeNumber          String?
  auctionType           String?
  auctionMethod         String?

  authorizedOfficer     String?
  officerDesignation    String?
  officerPhone          String?
  officerEmail          String?
  borrower              String?

  // Float replaces Decimal @db.Decimal — MongoDB has no SQL Decimal type.
  // Monetary values stored as Float (precision sufficient for INR auction amounts).
  reservePrice          Float?
  emd                   Float?
  minimumIncrement      Float?

  auctionStart          DateTime?
  auctionEnd            DateTime?
  applicationDeadline   DateTime?

  inspectionDate        DateTime?
  inspectionTime        String?
  inspectionLocation    String?
  inspectionContact     String?

  unitOrDoorNumber      String?
  floorNumber           String?
  buildingName          String?
  surveyOrKhasra        String?
  plotNumber            String?
  areaSqft              Float?
  areaType              String?

  possessionStatus      String?
  dscRequired           Boolean?
  acceptReserveAsFirstBid Boolean?
  autoExtension         Boolean?
  extensionDurationMins Int?
  extensionTrigger      String?

  status                AuctionStatus @default(UPCOMING)
  statusSource          String?

  sourceUrl             String?

  events                AuctionEvent[]
  changes               PropertyChange[]
  sourceRecords         SourceRecord[]

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status, auctionStart])
  @@index([bankId])
  @@index([externalAuctionId])
  // NOTE: MongoDB nulls participate in uniqueness (unlike PostgreSQL where two NULLs are always distinct).
  // Rows with bankId=null AND externalAuctionId=null will conflict. The dedup logic ensures at most one
  // null-null row exists; if that changes this constraint must become a sparse index via Atlas UI.
  @@unique([bankId, externalAuctionId])
  @@map("auctions")
}

model AuctionEvent {
  id         String        @id @default(cuid()) @map("_id")
  auctionId  String
  auction    Auction       @relation(fields: [auctionId], references: [id])
  fromStatus AuctionStatus?
  toStatus   AuctionStatus
  reason     String?
  sourceRecordId String?
  sourceRecord SourceRecord? @relation(fields: [sourceRecordId], references: [id])
  occurredAt DateTime      @default(now())

  @@map("auction_events")
}

model PropertyChange {
  id             String    @id @default(cuid()) @map("_id")
  propertyId     String?
  property       Property? @relation(fields: [propertyId], references: [id])
  auctionId      String?
  auction        Auction?  @relation(fields: [auctionId], references: [id])
  field          String
  oldValue       String?
  newValue       String?
  sourceRecordId String?
  sourceRecord   SourceRecord? @relation(fields: [sourceRecordId], references: [id])
  detectedAt     DateTime  @default(now())

  @@index([propertyId, detectedAt(sort: Desc)])
  @@index([auctionId])
  @@map("property_changes")
}

// ---------------------------------------------------------------------------
// Sources & ingestion provenance
// ---------------------------------------------------------------------------

enum SourceStatus {
  HEALTHY
  WARNING
  FAILED
  DISABLED
  RESTRICTED
}

model Source {
  id               String        @id @default(cuid()) @map("_id")
  name             String        @unique
  baseUrl          String
  status           SourceStatus  @default(RESTRICTED)
  robotsAllowed    Boolean?
  accessNotes      String?
  lastSuccessfulSync DateTime?
  lastAttemptedSync  DateTime?
  records          SourceRecord[]
  importJobs       ImportJob[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("sources")
}

enum SourceRecordStatus {
  NEW
  PROCESSED
  PENDING_REVIEW
  FAILED
  IGNORED
}

model SourceRecord {
  id              String             @id @default(cuid()) @map("_id")
  sourceId        String
  source          Source             @relation(fields: [sourceId], references: [id])
  sourceUrl       String
  externalId      String?
  contentHash     String?
  etag            String?
  lastModified    String?
  rawData         Json?
  extractionMethod String?
  aiProvider      String?
  aiModel         String?
  extractionConfidence Float?
  status          SourceRecordStatus @default(NEW)

  propertyId      String?
  property        Property?          @relation(fields: [propertyId], references: [id])
  auctionId       String?
  auction         Auction?           @relation(fields: [auctionId], references: [id])

  documents       SourceDocument[]
  media           SourceMedia[]
  attributes      PropertyAttribute[]
  auctionEvents   AuctionEvent[]
  propertyChanges PropertyChange[]

  sourcePublishedAt DateTime?

  firstSeenAt     DateTime           @default(now())
  lastSeenAt      DateTime           @default(now())
  lastCheckedAt   DateTime           @default(now())

  @@unique([sourceId, sourceUrl])
  @@index([status])
  @@map("source_records")
}

model ImportJob {
  id                String    @id @default(cuid()) @map("_id")
  sourceId          String
  source            Source    @relation(fields: [sourceId], references: [id])
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  pagesChecked      Int       @default(0)
  newProperties     Int       @default(0)
  updatedProperties Int       @default(0)
  newAuctions       Int       @default(0)
  updatedAuctions   Int       @default(0)
  documentsFound    Int       @default(0)
  imagesFound       Int       @default(0)
  aiCalls           Int       @default(0)
  duplicatesFound   Int       @default(0)
  failures          Int       @default(0)
  errorLog          Json?
  triggeredBy       String?

  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

enum DocumentType {
  SALE_NOTICE
  AUCTION_NOTICE
  SALE_PROCLAMATION
  BID_FORM
  TERMS_AND_CONDITIONS
  PROPERTY_SCHEDULE
  POSSESSION_NOTICE
  DEMAND_NOTICE
  CORRIGENDUM
  INSPECTION_NOTICE
  APPLICATION_FORM
  OTHER
}

model Document {
  id           String             @id @default(cuid()) @map("_id")
  type         DocumentType
  title        String?
  sourceUrl    String             @unique
  storedUrl    String?
  fileType     String?
  fileSizeBytes Int?
  checksum     String?
  properties   PropertyDocument[]
  sourceDocs   SourceDocument[]
  createdAt    DateTime           @default(now())

  @@map("documents")
}

// Composite @@id converted to synthetic id + @@unique for MongoDB compatibility.
model PropertyDocument {
  id         String   @id @default(cuid()) @map("_id")
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id])

  @@unique([propertyId, documentId])
  @@map("property_documents")
}

model SourceDocument {
  id             String       @id @default(cuid()) @map("_id")
  sourceRecordId String
  sourceRecord   SourceRecord @relation(fields: [sourceRecordId], references: [id])
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id])
  sourceUpdatedAt DateTime?
  importedAt     DateTime     @default(now())

  @@map("source_documents")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

enum MediaType {
  PHOTO
  FLOOR_PLAN
  SITE_PLAN
  MAP
  OTHER
}

model Media {
  id         String          @id @default(cuid()) @map("_id")
  type       MediaType
  sourceUrl  String
  storedUrl  String?
  checksum   String?
  width      Int?
  height     Int?
  properties PropertyMedia[]
  sourceRefs SourceMedia[]
  createdAt  DateTime        @default(now())

  @@index([sourceUrl])
  @@map("media")
}

// Composite @@id converted to synthetic id + @@unique for MongoDB compatibility.
model PropertyMedia {
  id         String   @id @default(cuid()) @map("_id")
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mediaId    String
  media      Media    @relation(fields: [mediaId], references: [id])
  sortOrder  Int      @default(0)

  @@unique([propertyId, mediaId])
  @@map("property_media")
}

model SourceMedia {
  id             String       @id @default(cuid()) @map("_id")
  sourceRecordId String
  sourceRecord   SourceRecord @relation(fields: [sourceRecordId], references: [id])
  mediaId        String
  media          Media        @relation(fields: [mediaId], references: [id])
  importedAt     DateTime     @default(now())

  @@map("source_media")
}

// ---------------------------------------------------------------------------
// Users & engagement
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id                String          @id @default(cuid()) @map("_id")
  email             String          @unique
  name              String?
  passwordHash      String
  role              UserRole        @default(USER)
  marketingConsent  Boolean         @default(false)
  consentUpdatedAt  DateTime?
  savedProperties   SavedProperty[]
  savedSearches     SavedSearch[]
  alerts            Alert[]
  reviews           Review[]
  createdAt         DateTime        @default(now())

  @@map("users")
}

// Composite @@id converted to synthetic id + @@unique for MongoDB compatibility.
model SavedProperty {
  id         String   @id @default(cuid()) @map("_id")
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  savedAt    DateTime @default(now())

  @@unique([userId, propertyId])
  @@map("saved_properties")
}

model SavedSearch {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String?
  filters   Json
  createdAt DateTime @default(now())

  @@map("saved_searches")
}

enum AlertType {
  NEW_MATCH
  DATE_CHANGE
  PRICE_CHANGE
  STATUS_CHANGE
}

model Alert {
  id        String    @id @default(cuid()) @map("_id")
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      AlertType
  filters   Json?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@map("alerts")
}

model Lead {
  id         String    @id @default(cuid()) @map("_id")
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  name       String
  phone      String?
  email      String?
  message    String?
  createdAt  DateTime  @default(now())

  @@map("leads")
}

model Review {
  id        String   @id @default(cuid()) @map("_id")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Site-wide settings (singleton row)
// ---------------------------------------------------------------------------

model SiteSettings {
  id                 String   @id @default(cuid()) @map("_id")
  phone              String?
  generalEmail       String?
  listingsEmail      String?
  partnershipsEmail  String?
  workingHours       String?
  facebookUrl        String?
  instagramUrl       String?
  linkedinUrl        String?
  youtubeUrl         String?
  privacyPolicy      String?
  termsAndConditions String?
  disclaimer         String?
  headerLogoUrl      String?
  footerLogoUrl      String?
  faviconUrl         String?
  homeTitle          String?
  homeDescription    String?
  homeKeywords       String?
  updatedAt          DateTime @updatedAt

  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// Blog
// ---------------------------------------------------------------------------

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id          String         @id @default(cuid()) @map("_id")
  slug        String         @unique
  title       String
  excerpt     String?
  body        String
  coverImageUrl String?
  category    String?
  tags        String[]       @default([])
  seoTitle    String?
  seoDescription String?
  status      BlogPostStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("blog_posts")
}

// ---------------------------------------------------------------------------
// Admin-managed localities and admin users
// ---------------------------------------------------------------------------

model Locality {
  id        String   @id @default(cuid()) @map("_id")
  city      String
  name      String
  slug      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([city, slug])
  @@map("localities")
}

enum AdminRole {
  MASTER
  ADMIN
}

model AdminUser {
  id           String    @id @default(cuid()) @map("_id")
  email        String    @unique
  name         String?
  passwordHash String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@map("admin_users")
}

model FeedSource {
  id          String    @id @default(cuid()) @map("_id")
  name        String    @unique
  url         String
  active      Boolean   @default(true)
  lastRunAt   DateTime?
  lastStatus  String?
  lastMessage String?
  contentHash String?
  sheetState  String?
  createdAt   DateTime  @default(now())

  @@map("feed_sources")
}

model SourceRunLog {
  id          String    @id @default(cuid()) @map("_id")
  source      String
  kind        String
  trigger     String
  status      String
  created     Int       @default(0)
  updated     Int       @default(0)
  duplicates  Int       @default(0)
  rejected    Int       @default(0)
  aiTokens    Int       @default(0)
  message     String?
  startedAt   DateTime  @default(now())
  durationMs  Int       @default(0)
  cursorPage  Int?
  endedAt     DateTime?

  @@index([startedAt])
  @@index([source, startedAt])
  @@map("source_run_logs")
}

// NOTE: SiteImage and MediaAsset store binary blobs (Bytes).
// MongoDB Atlas M0 free tier has a 512 MB storage limit.
// If media volume grows, move blobs to Vercel Blob or Cloudflare R2 and store only URLs here.
model SiteImage {
  key         String   @id @map("_id")
  contentType String
  data        Bytes
  sizeBytes   Int      @default(0)
  width       Int?
  height      Int?
  updatedAt   DateTime @updatedAt

  @@map("site_images")
}

model SitePage {
  key       String   @id @map("_id")
  data      Json
  updatedAt DateTime @updatedAt

  @@map("site_pages")
}

model MediaAsset {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  contentType String
  data        Bytes
  thumb       Bytes?
  sizeBytes   Int      @default(0)
  width       Int?
  height      Int?
  hash        String   @unique
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("media_assets")
}

model ApiKey {
  id           String    @id @default(cuid()) @map("_id")
  name         String
  prefix       String
  keyHash      String    @unique
  active       Boolean   @default(true)
  note         String?
  lastUsedAt   DateTime?
  requestCount Int       @default(0)
  createdAt    DateTime  @default(now())

  @@map("api_keys")
}

model HomeConfig {
  id           String   @id @default("default") @map("_id")
  heroTitle    String?
  heroSubtitle String?
  cities       String?
  typeOrder    String?
  banks        String?
  updatedAt    DateTime @updatedAt

  @@map("home_config")
}

model PaymentSettings {
  id        String   @id @default("default") @map("_id")
  provider  String   @default("razorpay")
  enabled   Boolean  @default(false)
  mode      String   @default("test")
  keyId     String?
  currency  String   @default("INR")
  plans     String?
  updatedAt DateTime @updatedAt

  @@map("payment_settings")
}

model Payment {
  id         String    @id @default(cuid()) @map("_id")
  provider   String    @default("razorpay")
  orderId    String?   @unique
  paymentId  String?
  email      String?
  planId     String?
  amount     Int
  currency   String    @default("INR")
  status     String    @default("created")
  note       String?
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  @@index([status, createdAt])
  @@map("payments")
}

model AuditLog {
  id         String   @id @default(cuid()) @map("_id")
  actorId    String?
  actorEmail String?
  action     String
  entityType String?
  entityId   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model AiSettings {
  id              String   @id @default("default") @map("_id")
  enabled         Boolean  @default(true)
  extractorModel  String?
  fallbackModel   String?
  extractionPrompt String?
  rules           String?
  maxPageChars    Int?
  updatedAt       DateTime @updatedAt

  @@map("ai_settings")
}

// ---------------------------------------------------------------------------
// Support tickets
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String        @id @default(cuid()) @map("_id")
  propertyId  String?
  property    Property?     @relation(fields: [propertyId], references: [id])
  reporterEmail String?
  subject     String
  body        String
  status      TicketStatus  @default(OPEN)
  resolvedAt  DateTime?
  resolvedBy  String?
  resolution  String?
  firstResponseAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([propertyId])
  @@map("support_tickets")
}
