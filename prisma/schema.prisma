// BankAuction.co — core database schema
// Postgres via Supabase now, portable to Postgres on Hostinger later.
// Design notes:
// - Fixed columns cover the common, always-relevant fields per the spec.
// - PropertyAttribute is an EAV table for category-specific fields (Khasra, BHK, vehicle make, etc.)
//   so we never add a column for a field that only applies to one property type.
// - Every ingested fact keeps provenance back to a SourceRecord.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Geography
// ---------------------------------------------------------------------------

model State {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  districts District[]
  cities    City[]
  createdAt DateTime   @default(now())

  @@map("states")
}

model District {
  id        String   @id @default(cuid())
  name      String
  slug      String
  stateId   String
  state     State    @relation(fields: [stateId], references: [id])
  cities    City[]
  createdAt DateTime @default(now())

  @@unique([stateId, slug])
  @@map("districts")
}

model City {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  stateId      String
  state        State       @relation(fields: [stateId], references: [id])
  districtId   String?
  district     District?   @relation(fields: [districtId], references: [id])
  latitude     Float?
  longitude    Float?
  properties   Property[]
  bankBranches BankBranch[]
  createdAt    DateTime    @default(now())

  @@map("cities")
}

// ---------------------------------------------------------------------------
// Banks
// ---------------------------------------------------------------------------

model Bank {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  shortCode   String?      // e.g. SBI, PNB, HDFC
  logoUrl     String?
  website     String?
  branches    BankBranch[]
  auctions    Auction[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("banks")
}

model BankBranch {
  id        String   @id @default(cuid())
  bankId    String
  bank      Bank     @relation(fields: [bankId], references: [id])
  name      String
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id])
  address   String?
  phone     String?
  email     String?
  auctions  Auction[]
  createdAt DateTime @default(now())

  @@unique([bankId, name])
  @@map("bank_branches")
}

// ---------------------------------------------------------------------------
// Property classification
// ---------------------------------------------------------------------------

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  LAND_PLOT
  AGRICULTURAL
  VEHICLE
}

model PropertyType {
  id        String            @id @default(cuid())
  category  PropertyCategory
  name      String            // e.g. "Apartment / Flat", "Warehouse", "Truck"
  slug      String            @unique
  subtypes  PropertySubtype[]
  properties Property[]
  createdAt DateTime          @default(now())

  @@map("property_types")
}

model PropertySubtype {
  id             String       @id @default(cuid())
  propertyTypeId String
  propertyType   PropertyType @relation(fields: [propertyTypeId], references: [id])
  name           String
  slug           String
  properties     Property[]
  createdAt      DateTime     @default(now())

  @@unique([propertyTypeId, slug])
  @@map("property_subtypes")
}

model Amenity {
  id         String              @id @default(cuid())
  name       String              @unique
  slug       String              @unique
  properties PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id])

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

// EAV table for fields that only apply to some categories (Khasra, BHK, vehicle make/model, etc.)
// value is stored as text; validation/normalization layer is responsible for typed parsing.
model PropertyAttribute {
  id             String    @id @default(cuid())
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  key            String    // e.g. "bhk", "khasra_number", "vehicle_make"
  value          String?
  unit           String?   // e.g. "sqft", "bigha"
  isKnown        Boolean   @default(true) // false => explicitly "Not Available" from source
  sourceRecordId String?
  sourceRecord   SourceRecord? @relation(fields: [sourceRecordId], references: [id])
  createdAt      DateTime  @default(now())

  @@unique([propertyId, key])
  @@map("property_attributes")
}

// ---------------------------------------------------------------------------
// Property + Auction (the core entities)
// ---------------------------------------------------------------------------

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  DUPLICATE
  EXPIRED
  REMOVED // hidden by an admin; re-imports never bring it back
}

model Property {
  id               String            @id @default(cuid())
  slug             String            @unique
  title            String
  description      String?           @db.Text
  category         PropertyCategory?
  propertyTypeId   String?
  propertyType     PropertyType?     @relation(fields: [propertyTypeId], references: [id])
  subtypeId        String?
  subtype          PropertySubtype?  @relation(fields: [subtypeId], references: [id])

  cityId           String?
  city             City?             @relation(fields: [cityId], references: [id])
  addressText      String?           // raw source address, never geocoded/invented
  latitude         Float?
  longitude        Float?

  status           PropertyStatus    @default(PENDING_REVIEW)
  extractionConfidence Float?        // 0..1, null if not AI-derived

  // AI-verified place, used by the City / Area filters (addressText stays the raw source text)
  geoCity          String?
  geoLocality      String?
  geoState         String?
  geoCheckedAt     DateTime?

  attributes       PropertyAttribute[]
  amenities        PropertyAmenity[]
  auctions         Auction[]
  documents        PropertyDocument[]
  media            PropertyMedia[]
  changes          PropertyChange[]
  sourceRecords    SourceRecord[]
  savedBy          SavedProperty[]
  leads            Lead[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([category, status])
  @@index([cityId])
  @@index([geoCity])
  @@map("properties")
}

enum AuctionStatus {
  UPCOMING
  LIVE
  AUCTION_TODAY
  COMPLETED
  POSTPONED
  CANCELLED
  EXPIRED
}

model Auction {
  id                    String        @id @default(cuid())
  propertyId            String
  property              Property      @relation(fields: [propertyId], references: [id])

  bankId                String?
  bank                  Bank?         @relation(fields: [bankId], references: [id])
  branchId              String?
  branch                BankBranch?   @relation(fields: [branchId], references: [id])

  externalAuctionId     String?       // ID as given by the source, used for dedup priority #1
  noticeNumber          String?       // dedup priority #2
  auctionType           String?
  auctionMethod         String?

  authorizedOfficer     String?
  officerDesignation    String?
  officerPhone          String?
  officerEmail          String?
  borrower              String?

  reservePrice          Decimal?      @db.Decimal(14, 2)
  emd                   Decimal?      @db.Decimal(14, 2)
  minimumIncrement      Decimal?      @db.Decimal(14, 2)

  auctionStart          DateTime?
  auctionEnd            DateTime?
  applicationDeadline   DateTime?

  inspectionDate        DateTime?
  inspectionTime        String?
  inspectionLocation    String?
  inspectionContact     String?

  possessionStatus      String?
  dscRequired           Boolean?
  acceptReserveAsFirstBid Boolean?
  autoExtension         Boolean?
  extensionDurationMins Int?
  extensionTrigger      String?

  status                AuctionStatus @default(UPCOMING)
  statusSource          String?       // "source_explicit" | "date_derived"

  sourceUrl             String?

  events                AuctionEvent[]
  changes               PropertyChange[]
  sourceRecords         SourceRecord[]

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status, auctionStart])
  @@index([bankId])
  @@map("auctions")
}

// Discrete status-transition history for an auction (e.g. UPCOMING -> POSTPONED)
model AuctionEvent {
  id         String        @id @default(cuid())
  auctionId  String
  auction    Auction       @relation(fields: [auctionId], references: [id])
  fromStatus AuctionStatus?
  toStatus   AuctionStatus
  reason     String?
  sourceRecordId String?
  sourceRecord SourceRecord? @relation(fields: [sourceRecordId], references: [id])
  occurredAt DateTime      @default(now())

  @@map("auction_events")
}

// Field-level change log (price changed, date changed, document replaced, etc.)
model PropertyChange {
  id             String    @id @default(cuid())
  propertyId     String?
  property       Property? @relation(fields: [propertyId], references: [id])
  auctionId      String?
  auction        Auction?  @relation(fields: [auctionId], references: [id])
  field          String    // e.g. "reserve_price", "auction_start", "status"
  oldValue       String?
  newValue       String?
  sourceRecordId String?
  sourceRecord   SourceRecord? @relation(fields: [sourceRecordId], references: [id])
  detectedAt     DateTime  @default(now())

  @@map("property_changes")
}

// ---------------------------------------------------------------------------
// Sources & ingestion provenance
// ---------------------------------------------------------------------------

enum SourceStatus {
  HEALTHY
  WARNING
  FAILED
  DISABLED
  RESTRICTED // access verified as not permitted; adapter exists but does not fetch
}

model Source {
  id               String        @id @default(cuid())
  name             String        @unique
  baseUrl          String
  status           SourceStatus  @default(RESTRICTED)
  robotsAllowed    Boolean?      // result of last robots.txt check
  accessNotes      String?       @db.Text // why restricted/healthy, ToS notes, etc.
  lastSuccessfulSync DateTime?
  lastAttemptedSync  DateTime?
  records          SourceRecord[]
  importJobs       ImportJob[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("sources")
}

enum SourceRecordStatus {
  NEW
  PROCESSED
  PENDING_REVIEW
  FAILED
  IGNORED
}

// One raw fetched page/record from a source. Multiple SourceRecords (from different
// sources, or re-fetches of the same URL) can point at the same normalized Property/Auction.
model SourceRecord {
  id              String             @id @default(cuid())
  sourceId        String
  source          Source             @relation(fields: [sourceId], references: [id])
  sourceUrl       String
  externalId      String?
  contentHash     String?            // hash of fetched content, used to skip unchanged pages
  etag            String?
  lastModified    String?
  rawData         Json?              // raw extracted fields prior to normalization
  extractionMethod String?           // "html_parser" | "ai" | "ocr_ai"
  aiProvider      String?
  aiModel         String?
  extractionConfidence Float?
  status          SourceRecordStatus @default(NEW)

  propertyId      String?
  property        Property?          @relation(fields: [propertyId], references: [id])
  auctionId       String?
  auction         Auction?           @relation(fields: [auctionId], references: [id])

  documents       SourceDocument[]
  media           SourceMedia[]
  attributes      PropertyAttribute[]
  auctionEvents   AuctionEvent[]
  propertyChanges PropertyChange[]

  firstSeenAt     DateTime           @default(now())
  lastSeenAt      DateTime           @default(now())
  lastCheckedAt   DateTime           @default(now())

  @@unique([sourceId, sourceUrl])
  @@index([status])
  @@map("source_records")
}

model ImportJob {
  id                String    @id @default(cuid())
  sourceId          String
  source            Source    @relation(fields: [sourceId], references: [id])
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  pagesChecked      Int       @default(0)
  newProperties     Int       @default(0)
  updatedProperties Int       @default(0)
  newAuctions       Int       @default(0)
  updatedAuctions   Int       @default(0)
  documentsFound    Int       @default(0)
  imagesFound       Int       @default(0)
  aiCalls           Int       @default(0)
  duplicatesFound   Int       @default(0)
  failures          Int       @default(0)
  errorLog          Json?
  triggeredBy       String?   // "schedule" | "manual"

  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

enum DocumentType {
  SALE_NOTICE
  AUCTION_NOTICE
  SALE_PROCLAMATION
  BID_FORM
  TERMS_AND_CONDITIONS
  PROPERTY_SCHEDULE
  POSSESSION_NOTICE
  DEMAND_NOTICE
  CORRIGENDUM
  INSPECTION_NOTICE
  APPLICATION_FORM
  OTHER
}

model Document {
  id           String             @id @default(cuid())
  type         DocumentType
  title        String?
  sourceUrl    String             @unique
  storedUrl    String?            // null if copying/storage is not permitted
  fileType     String?
  fileSizeBytes Int?
  checksum     String?
  properties   PropertyDocument[]
  sourceDocs   SourceDocument[]
  createdAt    DateTime           @default(now())

  @@map("documents")
}

model PropertyDocument {
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id])

  @@id([propertyId, documentId])
  @@map("property_documents")
}

model SourceDocument {
  id             String       @id @default(cuid())
  sourceRecordId String
  sourceRecord   SourceRecord @relation(fields: [sourceRecordId], references: [id])
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id])
  sourceUpdatedAt DateTime?
  importedAt     DateTime     @default(now())

  @@map("source_documents")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

enum MediaType {
  PHOTO
  FLOOR_PLAN
  SITE_PLAN
  MAP
  OTHER
}

model Media {
  id         String          @id @default(cuid())
  type       MediaType
  sourceUrl  String
  storedUrl  String?
  checksum   String?
  width      Int?
  height     Int?
  properties PropertyMedia[]
  sourceRefs SourceMedia[]
  createdAt  DateTime        @default(now())

  @@map("media")
}

model PropertyMedia {
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mediaId    String
  media      Media    @relation(fields: [mediaId], references: [id])
  sortOrder  Int      @default(0)

  @@id([propertyId, mediaId])
  @@map("property_media")
}

model SourceMedia {
  id             String       @id @default(cuid())
  sourceRecordId String
  sourceRecord   SourceRecord @relation(fields: [sourceRecordId], references: [id])
  mediaId        String
  media          Media        @relation(fields: [mediaId], references: [id])
  importedAt     DateTime     @default(now())

  @@map("source_media")
}

// ---------------------------------------------------------------------------
// Users & engagement
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  passwordHash   String
  role           UserRole        @default(USER)
  savedProperties SavedProperty[]
  savedSearches  SavedSearch[]
  alerts         Alert[]
  reviews        Review[]
  createdAt      DateTime        @default(now())

  @@map("users")
}

model SavedProperty {
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  savedAt    DateTime @default(now())

  @@id([userId, propertyId])
  @@map("saved_properties")
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String?
  filters   Json
  createdAt DateTime @default(now())

  @@map("saved_searches")
}

enum AlertType {
  NEW_MATCH
  DATE_CHANGE
  PRICE_CHANGE
  STATUS_CHANGE
}

model Alert {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      AlertType
  filters   Json?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@map("alerts")
}

model Lead {
  id         String    @id @default(cuid())
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  name       String
  phone      String?
  email      String?
  message    String?
  createdAt  DateTime  @default(now())

  @@map("leads")
}

model Review {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Site-wide settings (singleton row) — admin-editable contact info, social
// links and policy page content, so none of this is hardcoded in the UI.
// ---------------------------------------------------------------------------

model SiteSettings {
  id                 String   @id @default(cuid())
  phone              String?
  generalEmail       String?
  listingsEmail      String?
  partnershipsEmail  String?
  workingHours       String?
  facebookUrl        String?
  instagramUrl       String?
  linkedinUrl        String?
  youtubeUrl         String?
  privacyPolicy      String?  @db.Text
  termsAndConditions String?  @db.Text
  disclaimer         String?  @db.Text
  headerLogoUrl      String?  @db.Text // URL or data: URI
  footerLogoUrl      String?  @db.Text
  faviconUrl         String?  @db.Text
  homeTitle          String?
  homeDescription    String?  @db.Text
  homeKeywords       String?  @db.Text
  updatedAt          DateTime @updatedAt

  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// Blog
// ---------------------------------------------------------------------------

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  excerpt     String?
  body        String         @db.Text
  coverImageUrl String?
  status      BlogPostStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("blog_posts")
}

// ---------------------------------------------------------------------------
// Admin-managed search localities (SEO / search suggestions) and admin users
// ---------------------------------------------------------------------------

model Locality {
  id        String   @id @default(cuid())
  city      String
  name      String
  slug      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([city, slug])
  @@map("localities")
}

enum AdminRole {
  MASTER // everything, including sources, AI, payments and team
  ADMIN  // content only: dashboard, properties, add property, blog, locations
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

// Admin-managed link sources (CSV / Google Sheet) polled every 30 min
model FeedSource {
  id          String    @id @default(cuid())
  name        String    @unique
  url         String
  active      Boolean   @default(true)
  lastRunAt   DateTime?
  lastStatus  String?   // ok | error
  lastMessage String?   @db.Text
  contentHash String?   // hash of the last scanned page text; unchanged page => no AI call
  sheetState  String?   @db.Text // JSON: per-tab content hash and the AI column mapping (Google Sheets / CSV)
  createdAt   DateTime  @default(now())

  @@map("feed_sources")
}

// One row per pipeline run of any source (built-in crawler, link source, CSV import, cron tick).
model SourceRunLog {
  id          String    @id @default(cuid())
  source      String    // display name of the source
  kind        String    // builtin | feed | csv | cron
  trigger     String    // schedule | manual | cron | import
  status      String    // ok | error | skipped | blocked
  created     Int       @default(0)
  updated     Int       @default(0)
  duplicates  Int       @default(0)
  rejected    Int       @default(0)
  aiTokens    Int       @default(0)
  message     String?   @db.Text
  startedAt   DateTime  @default(now())
  durationMs  Int       @default(0)

  @@index([startedAt])
  @@map("source_run_logs")
}

// Single-row developer settings for the AI (Relay Models) layer. Environment variables are the fallback.
// Images uploaded by the master admin (home hero, city and property-type tiles). Served by /api/img/[key]
// with long-lived caching, so a large picture is never embedded in page HTML.
model SiteImage {
  key         String   @id // e.g. "hero-desktop", "city-mumbai-d", "type-RESIDENTIAL-m"
  contentType String
  data        Bytes
  sizeBytes   Int      @default(0)
  width       Int?
  height      Int?
  updatedAt   DateTime @updatedAt

  @@map("site_images")
}

// Editable public pages (about, privacy, terms, disclaimer, faq). `data` is the page content the master admin edits.
model SitePage {
  key       String   @id // about | privacy | terms | disclaimer | faq
  data      Json
  updatedAt DateTime @updatedAt

  @@map("site_pages")
}

// The media library: every image the master admin has uploaded, reusable in any slot without uploading again.
model MediaAsset {
  id          String   @id @default(cuid())
  name        String
  contentType String
  data        Bytes
  thumb       Bytes? // small preview (JPEG) so the library page stays light
  sizeBytes   Int      @default(0)
  width       Int?
  height      Int?
  hash        String   @unique // sha256 of the file: the same picture is never stored twice
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("media_assets")
}

// Keys that let another system read our public listing data through /api/v1.
model ApiKey {
  id           String    @id @default(cuid())
  name         String
  prefix       String // first characters of the key, shown in the list (the key itself is never stored)
  keyHash      String    @unique // sha256 of the key
  active       Boolean   @default(true)
  note         String?
  lastUsedAt   DateTime?
  requestCount Int       @default(0)
  createdAt    DateTime  @default(now())

  @@map("api_keys")
}

// Single-row home page content that the master admin edits.
model HomeConfig {
  id           String   @id @default("default")
  heroTitle    String?
  heroSubtitle String?  @db.Text
  cities       String?  @db.Text // JSON array of the 8 city names shown in "Explore by City", in display order
  typeOrder    String?  @db.Text // JSON array of property-type values, in the order the cards are shown
  updatedAt    DateTime @updatedAt

  @@map("home_config")
}

// Single-row payment gateway settings. Secret keys live in environment variables only, never here.
model PaymentSettings {
  id        String   @id @default("default")
  provider  String   @default("razorpay")
  enabled   Boolean  @default(false)
  mode      String   @default("test") // test | live
  keyId     String?
  currency  String   @default("INR")
  plans     String?  @db.Text // JSON array of plans
  updatedAt DateTime @updatedAt

  @@map("payment_settings")
}

model Payment {
  id         String    @id @default(cuid())
  provider   String    @default("razorpay")
  orderId    String?   @unique
  paymentId  String?
  email      String?
  planId     String?
  amount     Int       // in paise
  currency   String    @default("INR")
  status     String    @default("created") // created | paid | failed | refunded
  note       String?   @db.Text
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  @@index([status, createdAt])
  @@map("payments")
}

model AiSettings {
  id              String   @id @default("default")
  enabled         Boolean  @default(true)
  extractorModel  String?
  fallbackModel   String?
  extractionPrompt String? @db.Text
  rules           String?  @db.Text // standing instructions, one per line, added to every extraction
  maxPageChars    Int?
  updatedAt       DateTime @updatedAt

  @@map("ai_settings")
}
